class SQLitePage extends StatefulWidget {
  const SQLitePage({super.key});

  @override
  State<SQLitePage> createState() => _SQLitePageState();
}

class _SQLitePageState extends State<SQLitePage> {
  final List> _records = [
    {'id': '1', 'name': 'rohith', 'course': 'CSE'},
    {'id': '2', 'name': 'viki', 'course': 'CSE'},
    {'id': '3', 'name': 'manjith', 'course': 'CSE'},
  ];

  final TextEditingController _nameController = TextEditingController();
  final TextEditingController _courseController =
      TextEditingController(text: 'CSE');

  void _saveRecord() {
    if (_nameController.text.isNotEmpty) {
      setState(() {
